{
  "name": "pick-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "DIFY_API_BASE": "https://api.dify.ai/v1"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
